# ==== Секреты (НИКОГДА не коммитить — публичный репозиторий) ====
*.jks
*.keystore
keystore.properties
android/keystore.properties
local.properties
android/local.properties

# ==== Build output ====
.gradle
.cxx/
build/
bin/
gen/
*.iml
*.class
*.dex
*.ap_

# ==== IDE / инструменты ====
.idea
.vscode
.claude/

# ==== Логи и артефакты ====
*.log
*.apk
*.bak
.DS_Store
releases/android/*.apk

# ==== Любые скрытые файлы/папки с точкой не должны попадать в репозиторий ====
# (кроме самих git-конфигов). Покрывает .idea, .vscode, .claude, .github, .gradle и т.п.
.*
!.gitignore
!.gitattributes
