<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- VPN Permissions -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- System Permissions -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Mock GPS Location -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" tools:ignore="MockLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- v2.4.0: VPN Schedule (daily alarm) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:ignore="DiscouragedApi" />

    <application
        android:name=".CarheliaApplication"
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarheliaVPN"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        tools:targetApi="31">

        <service
            android:name=".widget.ServerListWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
            
        <activity
            android:name=".EasterEggActivity"
            android:theme="@style/Theme.CarheliaVPN"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".DebugActivity"
            android:theme="@style/Theme.CarheliaVPN"
            android:exported="false" />
            
        <activity
            android:name=".games.MinerActivity"
            android:theme="@style/Theme.CarheliaVPN"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <!-- MAIN/LAUNCHER снят отсюда — теперь у activity-alias'ов ниже (маскировка иконки/имени
                 приложения, см. IconDisguiseManager). Ровно один alias enabled в любой момент. -->


            <!-- Path Pattern for Content URIs (Telegram, Downloads) with generic MIME -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.ovpn" />
                <data android:pathPattern=".*\\.conf" />
                <data android:pathPattern=".*\\.OVPN" />
                <data android:pathPattern=".*\\.CONF" />
            </intent-filter>

            <!-- 3. Path Pattern for File URIs (Managers) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.ovpn" />
                <data android:pathPattern=".*\\.conf" />
                <data android:pathPattern=".*\\.OVPN" />
                <data android:pathPattern=".*\\.CONF" />
            </intent-filter>

            <!-- JSON конфиги (из Телеграм, файловых менеджеров) — ACTION_VIEW -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.JSON" />
            </intent-filter>

            <!-- JSON конфиги — ACTION_SEND (поделиться файлом из Телеграм) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- TON Connect 2.0 deep links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tc" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ton-connect" />
            </intent-filter>
        </activity>

        <!-- Маскировка иконки/названия — ровно один из трёх enabled, переключается
             IconDisguiseManager через PackageManager.setComponentEnabledSetting(). -->
        <activity-alias
            android:name=".LauncherReal"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCalculator"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calc"
            android:roundIcon="@mipmap/ic_launcher_calc"
            android:label="@string/disguise_calculator_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNotes"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notes"
            android:roundIcon="@mipmap/ic_launcher_notes"
            android:label="@string/disguise_notes_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.CarheliaVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="vpn" />
            
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="true" />
        </service>

        <service
            android:name=".service.VpnTileService"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- v2.4.0: VPN Schedule receiver -->
        <receiver
            android:name=".service.ScheduleReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.carnelia.vpn.SCHEDULE_CONNECT" />
                <action android:name="com.carnelia.vpn.SCHEDULE_DISCONNECT" />
            </intent-filter>
        </receiver>

        <!-- Анти-шпион: проверка каждого нового приложения сразу после установки -->
        <receiver
            android:name=".service.PackageInstallReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".StatisticsActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".LogsActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".AppSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN" />

        <activity
            android:name=".GeoSpoofActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".BlackWallActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".PrivacyPolicyActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".LeakTestActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <!-- v2.4.3: Tools Hub + security instruments -->
        <activity
            android:name=".ToolsHubActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".FingerprintCheckActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".DnsAuditActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".RouteTracerActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".TrafficGraphActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".TlsInspectorActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".PacketInspectorActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".TerminalActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />


        <activity
            android:name=".PortScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.CarheliaVPN"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <service
            android:name=".service.GeoSpoofService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- v2.4.0: DNS-only VPN service (encrypts DNS without full VPN) -->
        <service
            android:name=".service.DnsOnlyService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- v2.4.0: Network Boost service (WiFi + Mobile standalone) -->
        <service
            android:name=".service.NetworkBoostService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- P2P-чат: DHT-обнаружение пиров + прямой UDP-обмен сообщениями -->
        <service
            android:name=".service.ChatService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- v2.4.0: Standalone Tools screen -->
        <activity
            android:name=".StandaloneToolsActivity"
            android:exported="false" />

        <receiver
            android:name=".widget.VpnWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.carnelia.vpn.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vpn_widget_info_metadata" />
        </receiver>

        <!-- FileProvider — выдаёт content:// URI на скачанный APK для установки обновления -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
