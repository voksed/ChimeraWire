    <!-- Security Analysis Report (used in SecurityUtils) -->
    <string name="sec_report_high_intro">✅ هذا المفتاح آمن جدًا.\n\n</string>
    <string name="sec_report_med_intro">⚠️ مفتاح جيد، لكن قد يُحجب بواسطة DPI صارم.\n\n</string>
    <string name="sec_report_low_intro">⛔ يستخدم المفتاح تشفيرًا أو تمويهًا قديمًا.\n\n</string>

    <string name="sec_proto_vless">• البروتوكول: VLESS (حديث وسريع).\n</string>
